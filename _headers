# Cache rules for Cloudflare (read by wrangler, not served)
# three.js r128 never changes
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# pictures change rarely: keep them a week, then refresh in the background
/ref/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
